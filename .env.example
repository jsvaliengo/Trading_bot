# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env real para o GitHub.

# ============================================
# CREDENCIAIS BINANCE — um par por rede
# ============================================
# A rede ativa é controlada por TRADING_BOT_ENVIRONMENT (ou pelo comando /env no Telegram).
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Rede ativa no startup: "mainnet" ou "testnet".
# Se não definido, usa runtime/active_environment.txt (persistido via /env) ou "testnet" como fallback.
TRADING_BOT_ENVIRONMENT=testnet

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# Opcional: ambiente e logging
TRADING_BOT_ENV=prod
TRADING_BOT_RUNTIME_DIR=runtime
TRADING_BOT_LOG_LEVEL=INFO
TRADING_BOT_LOG_TO_STDOUT=true

# Relatório diário automático (Telegram)
TRADING_BOT_DAILY_REPORT_ENABLED=true
TRADING_BOT_DAILY_REPORT_HOUR_BRT=23
TRADING_BOT_DAILY_REPORT_MINUTE_BRT=55
TRADING_BOT_DAILY_REPORT_LOOKBACK_HOURS=24
# 0 = desativa o bloqueio por drawdown desde o pico de equity
TRADING_BOT_MAX_DRAWDOWN_PERCENT=30
# Checagem de aportes/saques na Futures para atualizar capital base
TRADING_BOT_CAPITAL_TRANSFER_CHECK_INTERVAL_SECONDS=60

# Simulated balance (APENAS TESTNET): cappa o wallet/available reportados pro
# bot como se tivesse apenas esse valor. Útil pra simular começar com capital
# pequeno sem fazer transfer na testnet. 0 = desabilitado. Ignorado em mainnet.
TRADING_BOT_SIMULATED_BALANCE_USD=0

# Double First (dobra primeira entrada por direção)
TRADING_BOT_DOUBLE_FIRST_LONG_ENABLED=false
TRADING_BOT_DOUBLE_FIRST_SHORT_ENABLED=false
TRADING_BOT_DOUBLE_FIRST_MULTIPLIER=2.0
# 0 = sem limite adicional de margem para ordem dobrada
TRADING_BOT_DOUBLE_FIRST_MAX_MARGIN_USDT=0
# global | symbol
TRADING_BOT_DOUBLE_FIRST_SCOPE=global

# Filtro de sentimento/viés de mercado (opcional)
# Quando ON, só entra na direção do viés detectado por par
TRADING_BOT_SENTIMENT_FILTER_ENABLED=false
TRADING_BOT_SENTIMENT_TIMEFRAME=1h
TRADING_BOT_SENTIMENT_LOOKBACK_CANDLES=120
TRADING_BOT_SENTIMENT_MIN_SCORE=2
TRADING_BOT_SENTIMENT_MIN_MOMENTUM_PERCENT=0.20
TRADING_BOT_SENTIMENT_CACHE_SECONDS=300

# IA consultiva (V1)
# off | consultive | gated
TRADING_BOT_AI_MODE=off
TRADING_BOT_AI_MODEL=gpt-5-mini
TRADING_BOT_AI_TIMEOUT_SECONDS=8
TRADING_BOT_AI_MAX_OUTPUT_TOKENS=1500
TRADING_BOT_AI_REASONING_EFFORT=low
TRADING_BOT_AI_CACHE_SECONDS=180
TRADING_BOT_AI_MIN_CONFIDENCE=80
TRADING_BOT_AI_NOTIFY_REJECTED=false
TRADING_BOT_AI_TELEGRAM_ENABLED=true
OPENAI_API_KEY=

# WebSocket kline streams (substitui REST polling de klines)
# Kill switch: defina como false pra forçar REST puro (debug / fallback)
TRADING_BOT_WEBSOCKET_ENABLED=true
TRADING_BOT_WEBSOCKET_STALENESS_SECONDS=30

# Métricas Prometheus (exporter HTTP embutido, /metrics)
TRADING_BOT_METRICS_ENABLED=true
TRADING_BOT_METRICS_HOST=127.0.0.1
TRADING_BOT_METRICS_PORT=9090

# Obrigatório para rodar MAINNET sem prompt interativo (ex.: server/CI):
# valores aceitos: sim | yes | true | 1 | eu_sei_o_risco
TRADING_BOT_MAINNET_CONFIRM=

# Simulação: bot opera como se tivesse apenas este valor (só testnet)
TRADING_BOT_SIMULATED_BALANCE_USD=173.49

# Take profit e trailing stop.
# Invariante: TRAILING_ACTIVATION_PERCENT >= TRAILING_DISTANCE_PERCENT + 0.15
# (fee_floor do breakeven lock ≈ 2×taker 0.05% + 0.05% de margem).
# Se a invariante for violada, o trailing ativa mas o stop já nasce pinado
# em ~+0.15% da entrada, fechando em micro-retração.
TRADING_BOT_TAKE_PROFIT_PERCENT=1.5
TRADING_BOT_TRAILING_ACTIVATION_PERCENT=0.70
TRADING_BOT_TRAILING_DISTANCE_PERCENT=0.40
