  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "trading-bot",
    "diagnostico"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Trading Bot — Diagnóstico",
  "uid": "trading-bot-diag",
  "version": 2,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "title": "✅ Saúde geral (1=OK)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(trading_bot_running == bool 1) * (trading_bot_drawdown_from_peak_percent bool < 15) * (trading_bot_positions_open_count bool < 12)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PROBLEMA",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "—"
        }
      }
    },
    {
      "id": 2,
      "title": "⚠️ WS streams stale (>30s)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
