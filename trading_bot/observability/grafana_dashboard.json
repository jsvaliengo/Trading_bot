        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(trading_bot_trades_closed_total{result=\"win\"}[1h])) / clamp_min(sum(rate(trading_bot_trades_closed_total[1h])), 1e-9)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
